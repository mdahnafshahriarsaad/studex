# Studex Environment Variables Template
PORT=5000
JWT_SECRET=your_jwt_secret_key_here_change_in_production
NODE_ENV=production

# Email Service Configuration (Optional for Production SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
FROM_EMAIL=noreply@studex.app
